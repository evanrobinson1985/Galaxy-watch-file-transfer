<?xml version="1.0" encoding="utf-8"?>
<!-- GitHub (sideload) edition only. These features aren't allowed or needed on Google Play. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- "Choose installed apps": list every app, including system apps. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!-- Updating itself from GitHub Releases. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <!-- Secure Folder bridge (RelayService). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <activity
            android:name=".RelayActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:exported="false"
            android:label="@string/app_name"
            android:launchMode="singleTop" />

        <receiver
            android:name=".UpdateResultReceiver"
            android:exported="false" />

        <service
            android:name=".RelayService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
