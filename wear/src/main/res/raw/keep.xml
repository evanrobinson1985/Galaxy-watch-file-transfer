<?xml version="1.0" encoding="utf-8"?>
<!-- Release builds shrink unused resources. Nothing in the app's code reads the Wear OS
     capability list (Google Play services reads it to tell the phone this app is installed),
     so it must be kept explicitly or the phone can't find the watch app. -->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@array/android_wear_capabilities" />
