<?xml version="1.0" encoding="utf-8"?>
<!-- Full-screen ring used as a ProgressBar progressDrawable. The ring's sweep follows the
     drawable level; the fixed 270° rotation makes it start at 12 o'clock. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape
            android:innerRadiusRatio="2.25"
            android:shape="ring"
            android:thicknessRatio="22"
            android:useLevel="false">
            <solid android:color="@color/progress_track" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <rotate
            android:fromDegrees="270"
            android:pivotX="50%"
            android:pivotY="50%"
            android:toDegrees="270">
            <shape
                android:innerRadiusRatio="2.25"
                android:shape="ring"
                android:thicknessRatio="22"
                android:useLevel="true">
                <solid android:color="@color/progress" />
            </shape>
        </rotate>
    </item>
</layer-list>
